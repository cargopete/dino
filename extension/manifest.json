{
  "manifest_version": 3,
  "name": "Dino",
  "version": "0.1.0",
  "description": "Lets Dino on this machine read and drive pages in tabs it opens, signed in as you. RFC-0022.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Dino", "default_popup": "popup.html" }
}
